<div class="page-header">
  <div class="breadcrumb"><a href="/research">研究</a> / <%= ticker %></div>
  <h2>📚 <%= shelf.name %> 报告书架</h2>
</div>

<% if (shelf.reports.length === 0) { %>
  <div class="empty-state">
    <p>暂无报告。完成七层分析后，报告会自动出现在这里。</p>
  </div>
<% } else { %>
  <% const own = shelf.reports.filter(r => r.source === 'own'); const community = shelf.reports.filter(r => r.source === 'community'); %>

  <div class="section-title">✍️ 自有研究（<%= own.length %> 篇）</div>
  <div class="entry-list">
    <% let lastDate = null; for (const r of own) { %>
      <% if (r.date !== lastDate) { lastDate = r.date; %>
        <div style="font-size:12px;color:var(--text-muted);margin-top:10px;text-transform:uppercase;letter-spacing:0.5px;">
          <%= r.date || '未归档（公司目录根）' %>
          <% if (r.redteam) { %>
            <span class="badge badge-green">✓ 红队检验</span>
          <% } else if (r.date) { %>
            <span class="badge badge-yellow">反方检验未执行</span>
          <% } %>
        </div>
      <% } %>
      <a class="entry-item" href="/reports/<%= ticker %>/<%= r.rel %>">
        <div class="entry-title"><%= r.title %></div>
      </a>
    <% } %>
  </div>

  <% if (community.length > 0) { %>
    <div class="section-title" style="margin-top:24px;">📥 外来资料（<%= community.length %> 篇 · 社区/书籍，非本人产出）</div>
    <div class="entry-list">
      <% for (const r of community) { %>
        <a class="entry-item" href="/reports/<%= ticker %>/<%= r.rel %>">
          <div class="entry-title"><%= r.title %> <span class="source-tag community">📥 外来</span></div>
        </a>
      <% } %>
    </div>
  <% } %>
<% } %>
