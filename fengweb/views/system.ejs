<div class="page-header">
  <h2 data-i18n="page.system">⚙️ 系统架构图</h2>
  <div class="breadcrumb"><a href="/" data-i18n="common.sysOverview">系统总览</a> / <span data-i18n="crumb.system">架构图 — 奇衡DK-CAPITAL 思想融入版</span></div>
</div>

<!-- Legend -->
<div class="card legend-card">
  <div class="legend-items">
    <span class="legend-item"><span class="legend-color" style="background:var(--ok-bg);"></span> 已有组件</span>
    <span class="legend-item"><span class="legend-color" style="background:var(--warn-bg);"></span> DK 新增</span>
    <span class="legend-item"><span class="legend-color" style="background:var(--accent-soft);"></span> 新增模块</span>
    <span class="legend-item"><span class="legend-color" style="background:var(--danger-bg);"></span> 交互检查</span>
    <span class="legend-item"><span class="legend-color" style="background:var(--primary-soft);"></span> 知识库</span>
  </div>
