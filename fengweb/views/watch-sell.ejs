<div class="page-header">
  <h2>📤 卖出 <%= holding.ticker %></h2>
  <div class="breadcrumb"><a href="/">系统总览</a> / <a href="/watch">持仓监控</a> / <a href="/watch/history">历史</a> / 卖出</div>
</div>

<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
    <div>
      <strong style="font-size:20px;"><%= holding.ticker %></strong>
      <span style="font-size:13px;color:var(--text-muted);margin-left:8px;"><%= holding.thesis?.benchmark || holding.ticker %></span>
    </div>
    <div style="text-align:right;">
      <div style="font-size:14px;color:var(--text-muted);">当前持仓</div>
      <div style="font-size:18px;font-weight:600;"><%= holding.position?.shares || 0 %> 股</div>
    </div>
  </div>
</div>

<div class="calc-grid">
  <!-- Form -->
  <div class="card">
    <div class="section-title">卖出信息</div>
    <div class="calc-form">
      <label>卖出价格 (¥)</label>
      <input id="sell-price" type="number" step="0.01" value="<%= holding.position?.current_price || holding.position?.avg_cost || '' %>">

      <label>卖出数量 (股)</label>
      <input id="sell-shares" type="number" step="1" value="<%= holding.position?.shares || 0 %>">
      <div style="font-size:12px;color:var(--text-muted);">全部卖出: <%= holding.position?.shares || 0 %> 股</div>

      <label>卖出理由</label>
      <select id="sell-reason" style="padding:8px 12px;border:1px solid var(--border);border-radius:var(--radius);font-size:14px;">
        <option value="">请选择...</option>
        <option value="价格止损">价格止损 (-20%)</option>
        <option value="趋势反转">趋势反转 (MA50<MA200)</option>
        <option value="论文失效">论文失效</option>
        <option value="估值泡沫">估值泡沫</option>
        <option value="基本面恶化">基本面恶化</option>
        <option value="钱仓滚存">钱仓滚存</option>
        <option value="目标达成">目标达成</option>
        <option value="更好的机会">更好的机会</option>
        <option value="需要现金">需要现金</option>
        <option value="其他">其他</option>
      </select>
      <input id="sell-reason-custom" type="text" placeholder="或自定义理由..." style="margin-top:4px;">

      <button class="btn btn-primary" onclick="confirmSell()" style="margin-top:8px;">确认卖出</button>
    </div>
  </div>

  <!-- Preview -->
  <div class="card">
    <div class="section-title">卖出预览</div>
    <div class="calc-result" id="preview">
      <div class="result-row"><span class="label">买入均价</span><span class="value"><%= holding.position?.avg_cost?.toFixed(2) || '—' %></span></div>
      <div class="result-row"><span class="label">卖出价格</span><span class="value" id="preview-price">—</span></div>
      <div class="result-row"><span class="label">卖出数量</span><span class="value" id="preview-shares">—</span></div>
      <div class="result-row" style="border-top:1px solid var(--border);padding-top:8px;margin-top:8px;">
        <span class="label">盈亏</span>
        <span class="value" id="preview-pnl">—</span>
      </div>
      <div class="result-row"><span class="label">盈亏金额</span><span class="value" id="preview-amount">—</span></div>
    </div>

    <div id="sell-alert" style="display:none;margin-top:12px;padding:10px 14px;border-radius:var(--radius);background:var(--red-bg);border:1px solid #fecaca;font-size:14px;color:var(--red);"></div>
  </div>
</div>

<script>
function updatePreview() {
  const price = parseFloat(document.getElementById('sell-price').value) || 0;
  const shares = parseFloat(document.getElementById('sell-shares').value) || 0;
  const avgCost = <%= holding.position?.avg_cost || 0 %>;
  const totalShares = <%= holding.position?.shares || 0 %>;

  document.getElementById('preview-price').textContent = price.toFixed(2);
  document.getElementById('preview-shares').textContent = shares + ' / ' + totalShares;

  if (price > 0 && shares > 0 && avgCost > 0) {
    const pnl = (price - avgCost) / avgCost * 100;
    const amount = (price - avgCost) * shares;
    const pnlEl = document.getElementById('preview-pnl');
    pnlEl.textContent = (pnl >= 0 ? '+' : '') + pnl.toFixed(1) + '%';
    pnlEl.style.color = pnl >= 0 ? 'var(--green)' : 'var(--red)';
    const amtEl = document.getElementById('preview-amount');
    amtEl.textContent = (amount >= 0 ? '+' : '') + amount.toFixed(0);
    amtEl.style.color = amount >= 0 ? 'var(--green)' : 'var(--red)';
  }
}

document.getElementById('sell-price').addEventListener('input', updatePreview);
document.getElementById('sell-shares').addEventListener('input', updatePreview);
updatePreview();

async function confirmSell() {
  const price = document.getElementById('sell-price').value;
  const shares = document.getElementById('sell-shares').value;
  const reasonSel = document.getElementById('sell-reason').value;
  const reasonCustom = document.getElementById('sell-reason-custom').value;
  const reason = reasonCustom || reasonSel;

  if (!price || !shares) {
    alert('请输入价格和数量');
    return;
  }

  if (!reason) {
    alert('请选择或输入卖出理由');
    return;
  }

  if (!confirm('确认卖出 <%= holding.ticker %> ' + shares + '股 @ ' + price + '?\n理由: ' + reason)) return;

  try {
    const res = await fetch('/api/watch/sell/<%= holding.ticker %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ price: parseFloat(price), shares: parseFloat(shares), reason }),
    });
    const data = await res.json();
    if (data.success) {
      alert('✅ 卖出已记录！');
      window.location.href = '/watch/history';
    } else {
      alert('❌ 卖出失败: ' + (data.message || data.error));
    }
  } catch (e) {
    alert('❌ 卖出失败: ' + e.message);
  }
}
</script>
