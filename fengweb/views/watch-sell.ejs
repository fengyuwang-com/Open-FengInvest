<div class="page-header">
  <h2>📤 卖出 <%= holding.ticker %></h2>
  <div class="breadcrumb"><a href="/holdings">持仓</a> / <a href="/watch">监控</a> / 卖出决策（四步，②③未完④不可点）</div>
</div>

<div class="card step-wizard">
  <div class="step-indicator">
    <div class="step-dot current" id="dot0"></div>
    <div class="step-dot" id="dot1"></div>
    <div class="step-dot" id="dot2"></div>
    <div class="step-dot" id="dot3"></div>
  </div>

  <!-- 第1步 触发源（fengwatch check 十规则实测） -->
  <div class="step-panel active" id="panel0">
    <h3>① 触发源识别（fengwatch check 十规则结果）</h3>
    <div id="trigger-check" style="margin-bottom:12px;color:var(--text-muted);font-size:13px;">加载规则检查中…</div>
    <div class="field-row">
      <select id="t-trigger" style="padding:8px 12px;border:1px solid var(--border-strong);border-radius:8px;">
        <option value="">选择触发源…</option>
        <option>机械规则触发（见上方检查结果）</option>
        <option>红线触发（thesis.redlines 命中）</option>
        <option>卖出条件触发（exit_conditions 命中）</option>
        <option>钱仓滚存检测（回收本金机会）</option>
        <option>无机械触发，是主动决策</option>
      </select>
    </div>
    <div class="field-row"><label>触发详情</label><textarea id="t-detail" rows="2" placeholder="具体是什么数据/事件"></textarea></div>
    <div class="step-nav"><span></span><button class="btn btn-primary" onclick="wizGo(1)">下一步 →</button></div>
  </div>

  <!-- 第2步 六类理由 -->
  <div class="step-panel" id="panel1">
    <h3>② 理由分类（六选一）</h3>
    <% var reasons = [ ['thesis_broken','论文坏了——买入逻辑被证伪'], ['valuation_target','估值达标——达到目标价/价差收敛'], ['better_opportunity','更好机会——机会成本切换'], ['need_cash','需要现金——生活/配置需求'], ['risk_control','风控止损/减仓'], ['rollover','钱仓滚存——回收本金'] ]; %>
    <% reasons.forEach(function(r) { %>
      <label style="display:block;padding:8px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;cursor:pointer;">
        <input type="radio" name="reason_class" value="<%= r[0] %>"> <b><%= r[1] %></b>
      </label>
    <% }) %>
    <div class="field-row" style="margin-top:8px;"><label>补充说明</label><textarea id="s-reason" rows="2"></textarea></div>
    <div class="step-nav"><button class="btn" onclick="wizGo(0)">← 上一步</button><button class="btn btn-primary" onclick="wizGo(2)">下一步 →</button></div>
  </div>

  <!-- 第3步 偏误自查 -->
  <div class="step-panel" id="panel2">
    <h3>③ 行为偏误自查（逐条打勾，至少 3 项）</h3>
    <% var biases = [ ['sunk_cost','沉没成本：我不是因为"已经亏了不甘心"而做决定'], ['loss_aversion','损失厌恶：我不是因为怕继续跌而恐慌卖出'], ['confirmation','确认偏误：我看过反方观点，不只看了支持卖出的信息'], ['anchoring','锚定：我不是因为股价回到我的成本价附近而卖'], ['disposition','处置效应：我不是因为"涨了想落袋"而卖掉赢家'], ['recency','近因效应：我不是只被最近几天走势影响'] ]; %>
    <% biases.forEach(function(b) { %>
      <label style="display:block;padding:8px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;cursor:pointer;">
        <input type="checkbox" class="bias-check" value="<%= b[0] %>"> <%= b[1] %>
      </label>
    <% }) %>
    <div class="step-nav"><button class="btn" onclick="wizGo(1)">← 上一步</button><button class="btn btn-primary" id="btnGoExec" disabled onclick="wizGo(3)">下一步 →（勾满 3 项解锁）</button></div>
  </div>

  <!-- 第4步 执行 -->
  <div class="step-panel" id="panel3">
    <h3>④ 执行卖出</h3>
    <div class="detail-grid">
      <div class="field-row"><label>卖出价格</label><input id="s-price" type="number" step="0.0001"></div>
      <div class="field-row"><label>卖出股数（留空=全部）</label><input id="s-shares" type="number" min="0"></div>
    </div>
    <button class="btn btn-danger" id="execBtn" onclick="execSell()">确认执行卖出（fengwatch sell 闭环）</button>
    <div id="sell-result" style="margin-top:12px;"></div>
    <div class="step-nav"><button class="btn" onclick="wizGo(2)">← 上一步</button><span></span></div>
  </div>
</div>

<script>
var cur = 0, reasonClass = null, biasAck = [];
(async function loadTriggers() {
  var el = document.getElementById('trigger-check');
  try {
    var r = await fetch('/api/watch/check/<%= holding.ticker %>');
    var d = await r.json();
    if (!r.ok) { el.innerHTML = '<span style="color:var(--warn);">⚠ 规则检查不可用（' + (d.error || '') + '）——你仍可做主动决策。</span>'; return; }
    var rules = d.rules || d.checks || [];
    el.innerHTML = Array.isArray(rules) && rules.length
      ? rules.map(function(x) {
          var bad = !String(x.status || x.triggered).match(/(ok|false|pass|未触发)/i);
          return '<div style="padding:4px 0;"><span class="badge badge-' + (bad ? 'red' : 'green') + '">' + (x.status || (x.triggered ? '触发' : '未触发')) + '</span> ' + (x.rule || x.name || '') + ' <span style="color:var(--text-muted);">' + (x.message || x.note || '') + '</span></div>';
        }).join('')
      : '检查完成（无逐条规则输出，详见控制台数据）';
  } catch (e) { el.textContent = '规则检查网络错误——你仍可做主动决策。'; }
})();
function wizGo(n) {
  if (n === 1 && !document.getElementById('t-trigger').value) { alert('先选触发源'); return; }
  if (n === 2) {
    var sel = document.querySelector('input[name=reason_class]:checked');
    if (!sel) { alert('六类理由必选'); return; }
    reasonClass = sel.value;
  }
  document.getElementById('panel' + cur).classList.remove('active');
  document.getElementById('dot' + cur).className = 'step-dot' + (n > cur ? ' done' : '');
  cur = n;
  document.getElementById('panel' + cur).classList.add('active');
  document.getElementById('dot' + cur).className = 'step-dot current';
}
document.querySelectorAll('.bias-check').forEach(function(c) {
  c.addEventListener('change', function() {
    biasAck = Array.from(document.querySelectorAll('.bias-check:checked')).map(function(x) { return x.value; });
    document.getElementById('btnGoExec').disabled = biasAck.length < 3;
  });
});
async function execSell() {
  var btn = document.getElementById('execBtn');
  btn.disabled = true; btn.textContent = '执行中…';
  try {
    var r = await fetch('/api/sell/execute/<%= holding.ticker %>', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        price: parseFloat(document.getElementById('s-price').value) || null,
        shares: parseFloat(document.getElementById('s-shares').value) || null,
        reason: document.getElementById('t-trigger').value + ' | ' + document.getElementById('s-reason').value,
        reason_class: reasonClass, bias_ack: biasAck,
      }),
    });
    var d = await r.json();
    var el = document.getElementById('sell-result');
    if (!r.ok) el.innerHTML = '<div class="alert alert-danger">' + (d.error || '失败') + '：' + (d.detail || '') + '</div>';
    else el.innerHTML = '<div class="alert alert-info">✅ ' + (d.message || '已保存') + '。<a href="/watch/history">查看历史 →</a></div>';
  } catch (e) {
    document.getElementById('sell-result').textContent = '网络错误: ' + e.message;
  }
  btn.disabled = false; btn.textContent = '确认执行卖出（fengwatch sell 闭环）';
}
</script>
