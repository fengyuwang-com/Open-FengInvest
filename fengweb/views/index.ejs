<div class="page-header">
  <h2 data-i18n="page.index">🏠 首页</h2>
  <div class="breadcrumb"><span data-i18n="crumb.index">该研究谁、到哪一步、谁该复盘 —— 今天需要你判断的事，排最前</span></div>
</div>

<!-- 今日待办（宪法 6.1：按紧急排序，每条带动作链接） -->
<div class="card">
  <h3 class="section-title" data-i18n="home.todo">☑️ 今日研究待办</h3>
  <% var todos = []; %>
  <% (sys.holdings || []).forEach(function(h) { %>
    <% var nd = h.triggers && h.triggers.next_review_date; if (!nd) return;
       var days = Math.round((new Date(nd) - new Date()) / 86400000); %>
    <% if (days < 0) { var eesc = function(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); };
       todos.push({lv:'danger', t:'<b>' + eesc(h.name || h.ticker) + '</b> 回顾日已过期 ' + (-days) + ' 天', href:'/holdings/' + h.ticker, act:'去复盘'}); } %>
  <% }) %>
  <% (sys.alerts || []).slice(0, 6).forEach(function(a) { %>
    <% var nm = (names[a.ticker] || {}); var aName = nm.zh || nm.en || a.ticker || '';
       var esc = function(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); };
       todos.push({lv:a.severity === 'danger' ? 'danger' : a.severity === 'warning' ? 'warning' : 'info', t:(a.ticker ? '<b>' + esc(aName) + '</b> ' : '') + esc(a.message), href:'/watch', act:'查看'}); %>
  <% }) %>
  <% if (todos.length === 0) { %>
    <div class="empty-state"><p>今日没有过期回顾、层缺口或监控告警。研究候选池去吧 → <a href="/research">研究列表</a></p></div>
  <% } else { %>
    <div class="alert-list">
      <% todos.slice(0, 8).forEach(function(td) { %>
        <div class="alert-item <%= td.lv %>"><span class="alert-text"><%- td.t %></span><a class="btn btn-sm" href="<%= td.href %>"><%= td.act %> →</a></div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- 已研究公司（研究透了才入此列，创始人定调：只有研究了/没研究） -->
<div class="card">
  <h3 class="section-title" data-i18n="home.studied">📚 已研究公司 <a href="/research" style="font-size:12px;font-weight:normal;margin-left:auto;">全部 →</a></h3>
  <% var active = meta.filter(function(m){ return m.layers && m.layers.length >= 7; }).slice(0, 6); %>
  <% if (active.length === 0) { %>
    <div class="empty-state"><p>没有已研究标的。候选池在 <a href="/research">研究列表</a> 等你挑。</p></div>
  <% } else { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;">
    <% active.forEach(function(c) { %>
      <a href="/research/<%= c.ticker %>" class="entry-item" style="margin:0;">
        <div class="entry-title"><%= c.name %></div>
        <div style="font-size:11px;color:var(--text-muted);"><%= c.ticker %> · 七层已完成 ✓</div>
      </a>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- 持仓公司（只显原则/论文/回顾日，无当日涨跌，宪法 6.1） -->
<div class="card">
  <h3 class="section-title" data-i18n="home.holdings">💼 持仓公司 <a href="/holdings" style="font-size:12px;font-weight:normal;margin-left:auto;">全部 →</a></h3>
  <% var hstocks = (sys.holdings || []).filter(function(h){ return h.asset_type !== 'cash'; }); %>
  <% if (hstocks.length === 0) { %>
    <div class="empty-state"><p>暂无持仓。<a href="/holdings/new">登记新持仓 →</a></p></div>
  <% } else { %>
  <table class="holdings-table">
    <thead><tr><th>公司</th><th>钱包</th><th>滚存阶段</th><th>下次回顾</th></tr></thead>
    <tbody>
      <% hstocks.forEach(function(h) { %>
      <% var nd = h.triggers && h.triggers.next_review_date;
         var overdue = nd && new Date(nd) < new Date(); %>
      <tr>
        <td><a href="/holdings/<%= h.ticker %>"><%= h.name || h.ticker %></a> <span style="font-size:11px;color:var(--text-muted);"><%= h.ticker %></span></td>
        <td><span class="badge badge-<%= h.account_type === 'TRADING' ? 'yellow' : 'neutral' %>"><%= h.account_type === 'TRADING' ? '投机' : '投资' %></span></td>
        <td style="font-size:12px;color:var(--text-muted);"><%= h.capital_rollover && h.capital_rollover.phase === 'recovered' ? '本金已回收 ✓' : '风险资本' %></td>
        <td <% if (overdue) { %>style="color:var(--danger);font-weight:600;"<% } %>><%= nd || '—' %><%= overdue ? ' 已过期' : '' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- 本周知识位（宪法 6.1） -->
<div class="card">
  <h3 class="section-title" data-i18n="home.knowledge">📚 本周知识 <a href="/knowledge" style="font-size:12px;font-weight:normal;margin-left:auto;">知识库 →</a></h3>
  <% if (sys.kbCategories && sys.kbCategories.length > 0) { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;">
    <% sys.kbCategories.slice(0, 5).forEach(function(cat) { %>
    <a href="/knowledge" class="kb-mini-card" style="display:block;padding:10px 14px;border:1px solid var(--border);border-radius:8px;text-decoration:none;color:inherit;">
      <div style="font-size:20px;font-weight:700;"><%= cat.count %></div>
      <div style="font-size:12px;color:var(--text-muted);"><%= cat.label %></div>
    </a>
    <% }) %>
  </div>
  <% } else { %><div class="empty-state"><p>知识库为空</p></div><% } %>
</div>

<!-- 最近决策 -->
<div class="card">
  <h3 class="section-title">📝 最近决策 <a href="/journal" style="font-size:12px;font-weight:normal;margin-left:auto;">决策日志 →</a></h3>
  <% if (sys.journal && sys.journal.length > 0) { %>
    <% sys.journal.slice(0, 6).forEach(function(e) { %>
    <div class="journal-entry">
      <div class="journal-date"><%= e.timestamp ? e.timestamp.slice(0,10) : '' %></div>
      <div class="journal-ticker"><%= e.ticker || '' %></div>
      <div class="journal-body"><%= e.message %></div>
    </div>
    <% }) %>
  <% } else { %><div class="empty-state"><p>暂无决策记录</p></div><% } %>
</div>

<!-- 大盘速览（参考信息，垫底） -->
<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <h3 class="section-title" style="font-size:14px;color:var(--text-muted);border:none;">📈 大盘速览（参考信息，不指导决策） <span id="market-updated" style="font-size:11px;color:var(--text-muted);font-weight:normal;"></span></h3>
    <button class="btn btn-sm btn-outline" onclick="refreshMarket()" type="button">刷新</button>
  </div>
  <div class="dashboard-grid" id="index-cards" style="margin-top:8px;">
    <div class="stat-card"><div class="stat-label">加载中...</div></div>
  </div>
</div>

<script>
async function refreshMarket() {
  document.getElementById('index-cards').innerHTML = '<div class="stat-card"><div class="stat-label">刷新中...</div></div>';
  try {
    const res = await fetch('/api/market/futu-overview');
    const data = await res.json();
    const indices = data.indices || {};
    const container = document.getElementById('index-cards');
    container.innerHTML = '';
    for (const [code, idx] of Object.entries(indices)) {
      const chg = idx.change_pct;
      const cls = chg > 0 ? 'positive' : (chg < 0 ? 'negative' : '');
      const arrow = chg > 0 ? '▲' : (chg < 0 ? '▼' : '—');
      const sign = chg > 0 ? '+' : '';
      container.innerHTML += `<div class="stat-card">
        <div class="stat-label">${idx.name}</div>
        <div class="stat-value num" style="font-size:22px;">${idx.price != null ? idx.price.toLocaleString() : '—'}</div>
        <div style="font-size:12px;${cls ? 'color:var(--' + cls + ');' : 'color:var(--text-muted);'}">${arrow} ${chg != null ? sign + chg.toFixed(2) + '%' : '—'}</div>
      </div>`;
    }
    document.getElementById('market-updated').textContent = '更新 ' + (data.fetched_at || '').slice(0, 16);
  } catch (e) {
    document.getElementById('index-cards').innerHTML = '<div class="stat-card"><div class="stat-label">获取失败</div></div>';
  }
}
refreshMarket();
</script>
