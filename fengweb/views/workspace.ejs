<div class="page-header">
  <div class="breadcrumb" data-i18n="crumb.workspace">决策台</div>
  <h2 data-i18n="page.workspace">🎯 决策台</h2>
  <p style="color:var(--text-muted);font-size:13px;margin-top:6px;" data-i18n="workspace.tagline">研究一家公司分七步，这里告诉你下一步轮到谁，并把这一步交给 AI 去做。</p>
</div>

<!-- 第一屏：现在轮到谁 -->
<div class="card">
  <h3 class="section-title" data-i18n="workspace.tasksTitle">现在轮到谁</h3>
  <div class="data-block" data-url="/api/workspace/tasks" data-render="renderTasks" data-empty-key="workspace.noTasks" data-empty="没有进行中的研究。从筛选流水线或研究清单挑一家开始。"></div>
</div>

<!-- 三步向导 -->
<div class="card" id="wizard">
  <h3 class="section-title" data-i18n="workspace.step1Title">第一步：选公司和这一步要做什么</h3>
  <div class="detail-grid">
    <div class="field-row"><label data-i18n="workspace.lblTicker">公司</label><input id="w-ticker" placeholder="如 0700.HK"></div>
    <div class="field-row"><label data-i18n="workspace.lblLayer">这一步</label>
      <!-- 选项由 /api/prompt/templates 渲染（层清单唯一来源 = PROMPT_LAYERS，加层不改此文件） -->
      <select id="w-layer"></select>
    </div>
  </div>
  <button class="btn btn-accent" id="genBtn" data-i18n="workspace.genPrompt" onclick="genPrompt()">生成指令（给 AI 的工作说明）</button>
  <span id="gen-hint" style="font-size:12px;color:var(--text-muted);margin-left:10px;"></span>
</div>

<div class="card">
  <h3 class="section-title" data-i18n="workspace.step2Title">第二步：把指令复制给任何外部 AI（如 ChatGPT / Claude）</h3>
  <textarea id="w-prompt" rows="10" style="width:100%;font-size:13px;font-family:monospace;border:1px solid var(--border-strong);border-radius:8px;padding:10px;" readonly data-i18n-ph="workspace.phPromptHere" placeholder="点上面的按钮，指令会出现在这里"></textarea>
  <button class="btn" data-i18n="workspace.copyPrompt" onclick="copyPrompt()">复制指令</button>
</div>

<div class="card">
  <h3 class="section-title" data-i18n="workspace.step3Title">第三步：把 AI 的结果贴回来，系统自动验收</h3>
  <p style="font-size:13px;color:var(--text-muted);margin-top:0;" data-i18n="workspace.step3Note">贴回后系统会检查格式是否合格；合格才算这一步完成。贴回整段输出即可。</p>
  <textarea id="w-output" rows="8" style="width:100%;font-size:13px;font-family:monospace;border:1px solid var(--border-strong);border-radius:8px;padding:10px;" data-i18n-ph="workspace.phPasteJson" placeholder='把外部 AI 的结果粘贴到这里'></textarea>
  <button class="btn btn-primary" id="subBtn" data-i18n="workspace.submitOutput" onclick="submitOutput()">提交并验收</button>
  <div id="w-result" style="margin-top:12px;"></div>
</div>

<!-- 工具箱（全部折叠，不挡路） -->
<details class="card" style="padding:16px 20px;">
  <summary style="cursor:pointer;font-weight:600;" data-i18n="workspace.toolbox">🧰 工具箱（批量筛选、数据更新、论断验证）</summary>

  <div style="margin-top:16px;">
    <h4 style="margin:0 0 8px 0;font-size:14px;" data-i18n="workspace.rlTitle">研究清单：调整一家公司的状态</h4>
    <div class="detail-grid">
      <div class="field-row"><label data-i18n="workspace.lblTicker2">公司</label><input id="rl-ticker" placeholder="0700.HK"></div>
      <div class="field-row"><label data-i18n="workspace.lblNewStatus">改成</label>
        <select id="rl-status"><option>researching</option><option>candidate</option><option>watching</option><option>holding</option><option>parked</option></select>
      </div>
    </div>
    <button class="btn btn-sm" id="rlBtn" data-i18n="workspace.updateStatus" onclick="rlSet()">更新状态</button>
    <span id="rl-out" style="margin-left:10px;font-size:13px;"></span>
  </div>

  <div style="margin-top:20px;">
    <h4 style="margin:0 0 8px 0;font-size:14px;" data-i18n="workspace.pipelineTitle">批量筛选：从公开名单里筛出值得研究的公司</h4>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <select id="scr-list" style="padding:8px 12px;border:1px solid var(--border-strong);border-radius:8px;">
        <option value="cn_dividend" data-i18n="workspace.optCnDividend">中证红利（A股）</option>
        <option value="us_quality" data-i18n="workspace.optUsQuality">美股质量</option>
        <option value="us_dividend" data-i18n="workspace.optUsDividend">美股红利</option>
      </select>
      <button class="btn btn-accent" id="scrBtn" data-i18n="workspace.runBatch" onclick="runScreen()">跑一批（约9分钟）</button>
    </div>
    <div id="scr-out" style="margin-top:12px;"></div>
    <div class="data-block" data-url="/api/screen/pipeline" data-render="renderBatches" data-empty-key="workspace.emptyBatches" data-empty="尚无批次"></div>
  </div>

  <div style="margin-top:20px;">
    <h4 style="margin:0 0 8px 0;font-size:14px;" data-i18n="workspace.dataUpdateTitle">数据更新：行情和财报补到最新</h4>
    <button class="btn btn-accent" id="updBtn" data-i18n="workspace.startUpdate" onclick="startUpdate()">开始更新（后台运行）</button>
    <div id="upd-out" style="margin-top:12px;"></div>
  </div>

  <div style="margin-top:20px;">
    <h4 style="margin:0 0 8px 0;font-size:14px;" data-i18n="workspace.verifyTitle">论断验证：重新回测一个已登记的结论</h4>
    <div class="field-row"><label data-i18n="workspace.lblClaimId">论断编号</label><input id="v-claim" data-i18n-ph="workspace.phClaimId" placeholder="如 1、8"></div>
    <button class="btn btn-accent" id="verifyBtn" data-i18n="workspace.runVerify" onclick="runVerify()">复测（可能较慢）</button>
    <div id="verifyOut" style="margin-top:12px;"></div>
  </div>
</details>

<script>
function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

var LAYER_TO_WIZARD = { 'l0': '01-capability', 'l2a': '05-qualitative', 'l3': '06-collision' };

// 层下拉唯一数据源 = GET /api/prompt/templates（后端 PROMPT_LAYERS 12 层），禁止在此硬编码选项
var _pendingLayer = null;
async function initLayerSelect() {
  var sel = document.getElementById('w-layer');
  try {
    var r = await fetch('/api/prompt/templates');
    var d = await r.json();
    sel.innerHTML = '';
    (d.layers || []).forEach(function(l) {
      var o = document.createElement('option');
      o.value = l.id;
      o.textContent = l.label;
      o.setAttribute('data-i18n', 'workspace.layer.' + l.id);
      sel.appendChild(o);
    });
    if (window.FengI18n) window.FengI18n.apply((window.localStorage && localStorage.getItem('feng_lang')) === 'en' ? 'en' : 'zh-CN');
    if (_pendingLayer) { sel.value = _pendingLayer; _pendingLayer = null; }
  } catch (e) { /* 端点失败时下拉留空，生成按钮会给出后端报错 */ }
}
initLayerSelect();

function renderTasks(d, el) {
  var tasks = d.tasks || [];
  if (!tasks.length) return;
  el.innerHTML = '<div style="display:flex;flex-direction:column;gap:8px;">' + tasks.slice(0, 8).map(function(t) {
    var prog = t.kind === 'start'
      ? FengI18n.t('workspace.taskNotStarted', '还没开始')
      : FengI18n.t('workspace.taskProgress', '已完成 ') + t.layers_done + FengI18n.t('workspace.taskOf7', '/7 步');
    var next = t.next_label || '';
    var act = '';
    if (t.next_layer && LAYER_TO_WIZARD[t.next_layer]) {
      act = '<button class="btn btn-sm btn-accent" onclick="pickTask(\'' + t.ticker + '\',\'' + LAYER_TO_WIZARD[t.next_layer] + '\')">' + FengI18n.t('workspace.taskDo', '做这一步') + '</button>';
    } else if (t.next_layer) {
      act = '<span style="font-size:12px;color:var(--text-muted);">' + FengI18n.t('workspace.taskViaSkill', '这一步在对话里跑 /fenginvest 技能') + '</span>';
    } else {
      act = '<a class="btn btn-sm" href="/research/' + t.ticker + '">' + FengI18n.t('workspace.taskView', '看研究') + '</a>';
    }
    return '<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 14px;border:1px solid var(--border);border-radius:10px;">' +
      '<div style="min-width:180px;"><b>' + esc(t.name) + '</b> <span style="font-size:12px;color:var(--text-muted);">' + esc(t.ticker) + '</span></div>' +
      '<div style="font-size:12px;color:var(--text-muted);min-width:110px;">' + esc(prog) + '</div>' +
      '<div style="font-size:13px;flex:1 1 200px;">下一步：' + esc(next) + '</div>' + act + '</div>';
  }).join('') + '</div>';
}
function pickTask(ticker, layer) {
  document.getElementById('w-ticker').value = ticker;
  document.getElementById('w-layer').value = layer;
  document.getElementById('wizard').scrollIntoView({ behavior: 'smooth' });
}

async function genPrompt() {
  var t = document.getElementById('w-ticker').value.trim();
  if (!t) { alert(FengI18n.t('workspace.alertFillTicker','先填公司代码')); return; }
  var btn = document.getElementById('genBtn');
  btn.disabled = true; btn.textContent = FengI18n.t('workspace.generating','生成中…');
  document.getElementById('gen-hint').textContent = '';
  try {
    var r = await fetch('/api/prompt/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ticker: t, layer: document.getElementById('w-layer').value }) });
    var d = await r.json();
    if (!r.ok) { alert((d.error || FengI18n.t('common.failed','失败')) + FengI18n.t('common.colonSep','：') + (d.detail || '')); }
    else { document.getElementById('w-prompt').value = d.prompt; document.getElementById('gen-hint').textContent = FengI18n.t('workspace.genHint','✓ 已生成，复制去下一步'); }
  } catch (e) { alert(FengI18n.t('common.networkError','网络错误') + ': ' + e.message); }
  btn.disabled = false; btn.textContent = FengI18n.t('workspace.genPrompt','生成指令（给 AI 的工作说明）');
}
function copyPrompt() {
  var ta = document.getElementById('w-prompt');
  ta.select(); document.execCommand('copy');
  document.getElementById('gen-hint').textContent = FengI18n.t('workspace.copied','✓ 已复制，去贴给外部 AI');
}
async function rlSet() {
  var t = document.getElementById('rl-ticker').value.trim();
  if (!t) { alert(FengI18n.t('workspace.alertTicker','填公司代码')); return; }
  var out = document.getElementById('rl-out');
  try {
    var r = await fetch('/api/research-list/' + encodeURIComponent(t) + '/status', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: document.getElementById('rl-status').value }),
    });
    var d = await r.json();
    out.innerHTML = r.ok ? '<span style="color:var(--ok);">✓ ' + d.from + ' → ' + d.to + '</span>' : '<span style="color:var(--danger);">' + (d.error || FengI18n.t('common.failed','失败')) + '</span>';
  } catch (e) { out.textContent = FengI18n.t('common.networkError','网络错误'); }
}
function renderBatches(d, el) {
  if (!d.batches || !d.batches.length) return;
  el.innerHTML = '<div style="margin-top:12px;"><b style="font-size:13px;">' + FengI18n.t('workspace.historyBatches','历史批次：') + '</b>' + d.batches.map(function(b) {
    var st = b.survivors ? (FengI18n.t('workspace.batchSurvivors','幸存 ') + (b.survivors.length || b.survivors.count || '?')) : (b.meta ? FengI18n.t('workspace.batchBuilt','已建') : FengI18n.t('workspace.batchNotRun','未跑'));
    return '<span class="badge badge-neutral" style="margin:2px;">' + b.batch + ' · ' + st + '</span>';
  }).join('') + '</div>';
}
async function runScreen() {
  var btn = document.getElementById('scrBtn');
  btn.disabled = true; btn.textContent = FengI18n.t('workspace.pipelineRunning','运行中…（粗筛→精筛）');
  var el = document.getElementById('scr-out');
  try {
    var r = await fetch('/api/screen/pipeline', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ list_name: document.getElementById('scr-list').value }) });
    var d = await r.json();
    el.innerHTML = r.ok ? '<div class="alert alert-info">' + FengI18n.t('workspace.pipelineDone','✅ 完成。幸存者名单已生成，回研究清单里挑下一家。') + '</div>'
      : '<div class="alert alert-danger">' + (d.error || FengI18n.t('common.failed','失败')) + FengI18n.t('common.colonSep','：') + (d.detail || '') + '</div>';
    window.FengData.fetchAll();
  } catch (e) { el.textContent = FengI18n.t('common.networkError','网络错误'); }
  btn.disabled = false; btn.textContent = FengI18n.t('workspace.runBatch','跑一批（约9分钟）');
}
async function startUpdate() {
  var btn = document.getElementById('updBtn');
  btn.disabled = true; btn.textContent = FengI18n.t('workspace.jobSubmitted','任务已提交…');
  var el = document.getElementById('upd-out');
  try {
    var r = await fetch('/api/data/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ scope: 'all' }) });
    var d = await r.json();
    if (!r.ok && r.status !== 202) { el.innerHTML = '<div class="alert alert-danger">' + (d.error || FengI18n.t('common.failed','失败')) + '</div>'; btn.disabled = false; btn.textContent = FengI18n.t('workspace.startUpdate','开始更新（后台运行）'); return; }
    el.innerHTML = '<div class="alert alert-info">' + FengI18n.t('workspace.jobQueued1','更新任务 ') + d.job_id + FengI18n.t('workspace.jobQueued2',' 已开始（行情+财报，需要几分钟）') + '</div><div id="upd-progress"></div>';
    var pid = setInterval(async function() {
      try {
        var pr = await fetch('/api/data/update/' + d.job_id);
        var p = await pr.json();
        var rows = p.steps.map(function(s) {
          var icon = s.status === 'done' ? '✅' : s.status === 'failed' ? '❌' : s.status === 'running' ? '⏳' : '·';
          return '<div>' + icon + ' ' + s.tool + ' [' + s.scope + '] ' + s.status + (s.error ? ' — ' + s.error : '') + '</div>';
        }).join('');
        var box = document.getElementById('upd-progress');
        if (box) box.innerHTML = '<div class="card" style="margin:8px 0;font-size:13px;">' + rows + '</div>';
        if (p.status !== 'running') {
          clearInterval(pid);
          btn.disabled = false; btn.textContent = FengI18n.t('workspace.startUpdate','开始更新（后台运行）');
          if (box) box.insertAdjacentHTML('beforeend', '<div class="alert ' + (p.status === 'done' ? 'alert-info' : 'alert-warning') + '">' + (p.status === 'done' ? FengI18n.t('workspace.allDone','✅ 全部完成') : FengI18n.t('workspace.partialFail','⚠ 部分失败（详见上）')) + '</div>');
        }
      } catch (e) { clearInterval(pid); btn.disabled = false; }
    }, 4000);
  } catch (e) { el.textContent = FengI18n.t('common.networkError','网络错误') + ': ' + e.message; btn.disabled = false; }
}
async function runVerify() {
  var id = document.getElementById('v-claim').value.trim();
  if (!id) { alert(FengI18n.t('workspace.alertFillClaim','填论断编号')); return; }
  var btn = document.getElementById('verifyBtn');
  btn.disabled = true; btn.textContent = FengI18n.t('workspace.verifyRunning','复测引擎运行中…');
  var el = document.getElementById('verifyOut');
  el.innerHTML = '<div class="alert alert-info">' + FengI18n.t('workspace.verifyWait','复测运行中（回测可能几分钟）') + '</div>';
  try {
    var r = await fetch('/api/verify/' + encodeURIComponent(id), { method: 'POST' });
    var d = await r.json();
    el.innerHTML = r.ok
      ? '<pre style="font-size:12px;white-space:pre-wrap;background:var(--bg-inset);padding:12px;border-radius:8px;max-height:480px;overflow:auto;">' + esc(typeof d === 'string' ? d : JSON.stringify(d, null, 2).slice(0, 8000)) + '</pre>'
      : '<div class="alert alert-danger">' + esc(d.error || FengI18n.t('common.failed','失败')) + FengI18n.t('common.colonSep','：') + esc(d.detail || '') + '</div>';
  } catch (e) { el.textContent = FengI18n.t('common.networkError','网络错误') + ': ' + e.message; }
  btn.disabled = false; btn.textContent = FengI18n.t('workspace.runVerify','复测（可能较慢）');
}
async function submitOutput() {
  var out = document.getElementById('w-output').value.trim();
  if (!out) { alert(FengI18n.t('workspace.alertPasteOutput','先贴回 AI 的结果')); return; }
  var btn = document.getElementById('subBtn');
  btn.disabled = true; btn.textContent = FengI18n.t('workspace.validating','验收中…');
  var el = document.getElementById('w-result');
  try {
    var r = await fetch('/api/prompt/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ticker: document.getElementById('w-ticker').value.trim(), layer: document.getElementById('w-layer').value, output: out }) });
    var d = await r.json();
    el.innerHTML = r.ok
      ? '<div class="alert alert-info">' + FengI18n.t('workspace.submitOk','✅ 验收通过，这一步已完成，回第一屏看下一步。') + '</div>'
      : '<div class="alert alert-danger">' + esc(d.error || FengI18n.t('common.failed','失败')) + FengI18n.t('common.colonSep','：') + esc(d.detail || '') + '</div>';
    if (r.ok) window.FengData.fetchAll();
  } catch (e) { el.textContent = FengI18n.t('common.networkError','网络错误') + ': ' + e.message; }
  btn.disabled = false; btn.textContent = FengI18n.t('workspace.submitOutput','提交并验收');
}
</script>
