<div class="page-header">
  <div class="breadcrumb"><span data-i18n="crumb.alerts">提醒中心 — alerts/today.json + 回顾日合并</span></div>
  <h2 data-i18n="page.alerts">🔔 提醒中心</h2>
</div>

<div class="filter-tabs">
  <button class="btn btn-sm tab-active" data-tab="today">今日</button>
  <button class="btn btn-sm" data-tab="overdue">回顾过期</button>
</div>

<div class="card" id="tab-today">
  <h3 class="section-title">今日提醒</h3>
  <div class="data-block" data-url="/api/watch/status" data-render="renderAlerts" data-empty="今日暂无提醒——跑一次 fengwatch daily 生成">
    <button class="btn btn-accent" onclick="runDaily(this)">跑每日检查（fengwatch daily）</button>
  </div>
</div>

<div class="card" id="tab-overdue" style="display:none;">
  <h3 class="section-title">回顾日过期持仓（严重级：红）</h3>
  <div class="data-block" data-url="/api/holdings" data-render="renderOverdue" data-empty="无持仓数据"></div>
</div>

<div class="card">
  <h3 class="section-title">最近决策日志（提醒相关动作留痕）</h3>
  <div class="data-block" data-url="/api/journal?limit=15" data-render="renderJournal" data-empty="暂无日志"></div>
</div>

<script>
function renderAlerts(d, el) {
  var list = d.alerts || d.items || [];
  var html = (Array.isArray(list) && list.length ? '' : '<div class="empty-state"><p>今日暂无提醒。</p><button class="btn btn-accent" onclick="runDaily(this)">跑每日检查（fengwatch daily）</button></div>');
  if (Array.isArray(list) && list.length) {
    html += '<div class="alert-list">' + list.map(function(a) {
      return '<div class="alert-item ' + (a.severity || 'info') + '"><span class="alert-tag ' + (a.severity || 'info') + '">' + (a.type || '提醒') + '</span><span>' + (a.ticker ? '[' + fengName(a.ticker) + '] ' : '') + (a.message || '') + '</span></div>';
    }).join('') + '</div>';
  }
  el.innerHTML = html;
}
function renderJournal(d, el) {
  var entries = Array.isArray(d) ? d : (d.entries || []);
  el.innerHTML = '<div>' + entries.map(function(e) {
    return '<div class="journal-entry"><div class="journal-date">' + (e.timestamp || '').slice(0, 10) + '</div><div class="journal-ticker">' + (e.ticker ? fengName(e.ticker) : '') + '</div><div class="journal-body">' + (e.message || '') + '</div></div>';
  }).join('') + '</div>';
}
function renderOverdue(list, el) {
  var now = new Date();
  var rows = (Array.isArray(list) ? list : []).filter(function(h) {
    return h.triggers && h.triggers.next_review_date && new Date(h.triggers.next_review_date) < now;
  });
  el.innerHTML = rows.length
    ? '<div class="alert-list">' + rows.map(function(h) {
        return '<div class="alert-item danger"><span class="alert-tag danger">过期</span><span><b>' + (h.name || h.ticker) + '</b> 回顾日 ' + h.triggers.next_review_date + '</span><a class="btn btn-sm" href="/holdings/' + h.ticker + '/review">去复盘 →</a></div>';
      }).join('') + '</div>'
    : '<div class="empty-state"><p>没有过期回顾。✓</p></div>';
}
async function runDaily(btn) {
  btn.disabled = true; btn.textContent = 'fengwatch daily 运行中…（可能几分钟）';
  try {
    var r = await fetch('/api/watch/daily', { method: 'POST' });
    var d = await r.json();
    if (r.ok) { window.FengData.fetchAll(); btn.textContent = '✅ 已生成'; }
    else { btn.textContent = '失败：' + (d.error || ''); btn.disabled = false; return; }
  } catch (e) { btn.textContent = '网络错误'; }
  btn.disabled = false;
}
(function() {
  document.querySelectorAll('.filter-tabs [data-tab]').forEach(function(b) {
    b.addEventListener('click', function() {
      document.querySelectorAll('.filter-tabs [data-tab]').forEach(function(x) { x.classList.remove('tab-active'); x.style.background = 'var(--bg-inset)'; x.style.color = 'var(--text)'; });
      b.classList.add('tab-active'); b.style.background = 'var(--primary)'; b.style.color = 'var(--bg-card)';
      document.getElementById('tab-today').style.display = b.dataset.tab === 'today' ? '' : 'none';
      document.getElementById('tab-overdue').style.display = b.dataset.tab === 'overdue' ? '' : 'none';
      if (b.dataset.tab === 'overdue') window.FengData.fetchOne(document.querySelector('#tab-overdue .data-block'));
    });
  });
  var f = document.querySelector('.filter-tabs [data-tab="today"]');
  if (f) { f.style.background = 'var(--primary)'; f.style.color = 'var(--bg-card)'; }
})();
</script>
