<script>
async function loadComprehensive() {
  document.getElementById('market-loading').style.display = 'block';
  document.getElementById('market-dashboard').style.display = 'none';

  try {
    const res = await fetch('/api/market/comprehensive');
    const d = await res.json();
    document.getElementById('market-loading').style.display = 'none';
    document.getElementById('market-dashboard').style.display = 'block';

    // 宪法 3.2/3.4：陈旧度横幅
    var banner = document.getElementById('stale-banner');
    if (!banner) {
      banner = document.createElement('div');
      banner.id = 'stale-banner';
      banner.className = 'red-team-bar missing';
      banner.style.marginBottom = '16px';
      document.getElementById('market-dashboard').prepend(banner);
    }
    if (d._stale) {
      banner.style.display = 'block';
      banner.innerHTML = '<div class="rt-title">⏳ 数据陈旧提示</div><div class="rt-row">市场快照已超过 24 小时未更新' + (d._age_hours != null ? '（' + d._age_hours + ' 小时前）' : '（本地无快照时间）') + '。数字仅作参考，决策前请到决策台跑一次「数据一键更新」。</div>';
    } else { banner.style.display = 'none'; }

    // Indices
    const indices = d.indices || {};
    const idxC = document.getElementById('index-cards');
    idxC.innerHTML = '';
    for (const [, idx] of Object.entries(indices)) {
      const chg = idx.change_pct;
      const cls = chg > 0 ? 'positive' : (chg < 0 ? 'negative' : '');
      const arrow = chg > 0 ? '&#9650;' : (chg < 0 ? '&#9660;' : '&mdash;');
      idxC.innerHTML += '<div class="stat-card"><div class="stat-label">' + idx.name + '</div><div class="stat-value ' + cls + '" style="font-size:22px;">' + (idx.price != null ? Number(idx.price).toLocaleString(undefined, {maximumFractionDigits:2}) : '&mdash;') + '</div><div style="font-size:12px;' + (cls ? 'color:var(--' + cls + ');' : '') + '">' + arrow + ' ' + (chg != null ? chg.toFixed(2) + '%' : '&mdash;') + '</div></div>';
    }

    // Valuation
    const val = d.valuation || {};
    const vd = document.getElementById('val-content');
    if (val.hsi_pe_current != null) {
      function bar(l, cur, pct) {
        if (cur == null) return '';
        const p = pct != null ? pct : 50;
        const c = pct < 30 ? 'var(--ok)' : pct < 70 ? 'var(--warn)' : 'var(--danger)';
        return '<div style="margin:4px 0;"><div style="display:flex;justify-content:space-between;font-size:13px;"><span><b>' + l + '</b> ' + Number(cur).toFixed(1) + '</span><span style="color:' + c + ';">' + (pct != null ? Number(pct).toFixed(1) + '% 分位' : '') + '</span></div><div style="height:8px;background:var(--border);border-radius:4px;"><div style="width:' + Math.min(p, 100) + '%;height:8px;background:' + c + ';border-radius:4px;"></div></div></div>';
      }
      vd.innerHTML = bar('PE', val.hsi_pe_current, val.hsi_pe_percentile) + bar('PB', val.hsi_pb_current, val.hsi_pb_percentile) + bar('PS', val.hsi_ps_current, val.hsi_ps_percentile);
    } else vd.innerHTML = '<p style="color:var(--text-muted);font-size:13px;">暂无</p>';

    // FedWatch
    const fed = d.fedwatch || {};
    const fd = document.getElementById('fed-content');
    if (fed.probability != null) {
      fd.innerHTML = '<div style="display:flex;gap:16px;"><div style="flex:1;text-align:center;padding:12px;background:var(--bg-inset);border-radius:8px;"><div style="font-size:28px;font-weight:700;color:var(--ok);">' + Number(fed.probability).toFixed(1) + '%</div><div style="font-size:12px;color:var(--text-muted);">维持不变概率</div></div></div>';
    } else fd.innerHTML = '<p style="color:var(--text-muted);font-size:13px;">暂无</p>';

    // Economic calendar
    const ec = d.economic_calendar || [];
    const ecd = document.getElementById('econ-content');
    if (ec.length > 0) {
      let h = '<table style="width:100%;font-size:13px;"><tr><th>日期</th><th>事件</th><th>地区</th></tr>';
      for (const e of ec) h += '<tr><td>' + (e.date || '') + '</td><td>' + (e.event || '') + '</td><td>' + (e.country || e.importance || '') + '</td></tr>';
      h += '</table>'; ecd.innerHTML = h;
    } else ecd.innerHTML = '<p style="color:var(--text-muted);font-size:13px;">暂无</p>';

    // Warnings
    const w = d._warnings || [];
    if (w.length > 0) {
      document.getElementById('market-warnings').style.display = 'block';
      document.getElementById('warnings-content').innerHTML = w.join('<br>');
    }

    document.getElementById('market-updated').textContent = '更新 ' + (d.fetched_at || '').slice(0, 16);
  } catch (e) {
    document.getElementById('market-loading').innerHTML = '<p style="color:var(--text-muted);">加载失败: ' + e.message + '</p><button class="btn btn-primary" onclick="loadComprehensive()" type="button" style="margin-top:8px;">重试</button>';
  }
}
loadComprehensive();
</script>
