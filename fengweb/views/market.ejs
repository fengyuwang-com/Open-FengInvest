<script>
async function loadComprehensive() {
  document.getElementById('market-loading').style.display = 'block';
  document.getElementById('market-dashboard').style.display = 'none';

  try {
    const res = await fetch('/api/market/comprehensive');
    const d = await res.json();
    document.getElementById('market-loading').style.display = 'none';
    document.getElementById('market-dashboard').style.display = 'block';

    // 宪法 3.2/3.4：陈旧度横幅
    var banner = document.getElementById('stale-banner');
    if (!banner) {
      banner = document.createElement('div');
      banner.id = 'stale-banner';
      banner.className = 'red-team-bar missing';
      banner.style.marginBottom = '16px';
      document.getElementById('market-dashboard').prepend(banner);
    }
    if (d._stale) {
      banner.style.display = 'block';
      banner.innerHTML = '<div class="rt-title">' + FengI18n.t('market.staleTitle','⏳ 数据陈旧提示') + '</div><div class="rt-row">' + FengI18n.t('market.staleBody','市场快照已超过 24 小时未更新') + (d._age_hours != null ? FengI18n.t('market.staleHoursPre','（') + d._age_hours + FengI18n.t('market.staleHoursPost',' 小时前）') : FengI18n.t('market.staleNoTime','（本地无快照时间）')) + FengI18n.t('market.staleAdvice','。数字仅作参考，决策前请到决策台跑一次「数据一键更新」。') + '</div>';
    } else { banner.style.display = 'none'; }

    // Indices
    const indices = d.indices || {};
    const idxC = document.getElementById('index-cards');
    idxC.innerHTML = '';
    for (const [, idx] of Object.entries(indices)) {
      const chg = idx.change_pct;
      const cls = chg > 0 ? 'positive' : (chg < 0 ? 'negative' : '');
      const arrow = chg > 0 ? '&#9650;' : (chg < 0 ? '&#9660;' : '&mdash;');
      idxC.innerHTML += '<div class="stat-card"><div class="stat-label">' + idx.name + '</div><div class="stat-value ' + cls + ' mkt-val-plain">' + (idx.price != null ? Number(idx.price).toLocaleString(undefined, {maximumFractionDigits:2}) : '&mdash;') + '</div><div style="font-size:12px;' + (cls ? 'color:var(--' + cls + ');' : '') + '">' + arrow + ' ' + (chg != null ? chg.toFixed(2) + '%' : '&mdash;') + '</div></div>';
    }

    // Valuation
    const val = d.valuation || {};
    const vd = document.getElementById('val-content');
    if (val.hsi_pe_current != null) {
      function bar(l, cur, pct) {
        if (cur == null) return '';
        const p = pct != null ? pct : 50;
        const c = pct < 30 ? 'var(--ok)' : pct < 70 ? 'var(--warn)' : 'var(--danger)';
        return '<div class="mkt-m4"><div class="mkt-flex-between"><span><b>' + l + '</b> ' + Number(cur).toFixed(1) + '</span><span style="color:' + c + ';">' + (pct != null ? Number(pct).toFixed(1) + FengI18n.t('market.pctile','% 分位') : '') + '</span></div><div class="mkt-bar-track"><div style="width:' + Math.min(p, 100) + '%;height:8px;background:' + c + ';border-radius:4px;"></div></div></div>';
      }
      vd.innerHTML = bar('PE', val.hsi_pe_current, val.hsi_pe_percentile) + bar('PB', val.hsi_pb_current, val.hsi_pb_percentile) + bar('PS', val.hsi_ps_current, val.hsi_ps_percentile);
    } else vd.innerHTML = '<p class="mkt-muted">' + FengI18n.t('market.none','暂无') + '</p>';

    // FedWatch
    const fed = d.fedwatch || {};
    const fd = document.getElementById('fed-content');
    if (fed.probability != null) {
      fd.innerHTML = '<div class="mkt-flex"><div class="mkt-inset-c"><div class="mkt-val-lg">' + Number(fed.probability).toFixed(1) + '%</div><div class="mkt-muted-sm">' + FengI18n.t('market.holdProb','维持不变概率') + '</div></div></div>';
    } else fd.innerHTML = '<p class="mkt-muted">' + FengI18n.t('market.none','暂无') + '</p>';

    loadFx();

    // Economic calendar
    const ec = d.economic_calendar || [];
    const ecd = document.getElementById('econ-content');
    if (ec.length > 0) {
      let h = '<table class="mkt-table"><tr><th>' + FengI18n.t('market.thDate','日期') + '</th><th>' + FengI18n.t('market.thEvent','事件') + '</th><th>' + FengI18n.t('market.thRegion','地区') + '</th></tr>';
      for (const e of ec) h += '<tr><td>' + (e.date || '') + '</td><td>' + (e.event || '') + '</td><td>' + (e.country || e.importance || '') + '</td></tr>';
      h += '</table>'; ecd.innerHTML = h;
    } else ecd.innerHTML = '<p class="mkt-muted">' + FengI18n.t('market.none','暂无') + '</p>';

    // Warnings
    const w = d._warnings || [];
    if (w.length > 0) {
      document.getElementById('market-warnings').style.display = 'block';
      document.getElementById('warnings-content').innerHTML = w.join('<br>');
    }

    document.getElementById('market-updated').textContent = FengI18n.t('market.updatedPrefix','更新 ') + (d.fetched_at || '').slice(0, 16);
  } catch (e) {
    document.getElementById('market-loading').innerHTML = '<p class="mkt-muted-xs">' + FengI18n.t('market.loadFailed','加载失败: ') + e.message + '</p><button class="btn btn-primary" onclick="loadComprehensive()" type="button" class="mkt-mt8">' + FengI18n.t('market.retry','重试') + '</button>';
  }
}

// FX 汇率卡片：fengfx.py latest（纯本地库，独立于 comprehensive 缓存）
async function loadFx() {
  const el = document.getElementById('fx-content');
  try {
    const res = await fetch('/api/fx/latest');
    const fx = await res.json();
    if (!fx.pairs || fx.pairs.length === 0) throw new Error('no data');
    let h = '<div class="mkt-fx-grid">';
    for (const p of fx.pairs) {
      h += '<div class="mkt-inset">'
        + '<div class="mkt-muted-sm">' + p.ticker + ' · ' + p.name + '</div>'
        + '<div class="mkt-val">' + Number(p.close).toFixed(4) + '</div>'
        + '<div class="mkt-muted-xs">' + (p.date || '') + '</div>'
        + '</div>';
    }
    h += '</div>';
    if (fx.spread) {
      const s = fx.spread;
      const color = s.warn ? 'var(--warn)' : 'var(--text-muted)';
      h += '<p style="font-size:12px;margin:10px 0 0;color:' + color + ';">'
        + FengI18n.t('market.fxSpread','在岸/离岸价差') + ': <b>' + (s.spread_pct > 0 ? '+' : '') + s.spread_pct.toFixed(3) + '%</b>'
        + (s.warn ? ' · ⚠️ ' + FengI18n.t('market.fxSpreadWarn','超 0.5% 警戒线') : '');
    }
    el.innerHTML = h;
  } catch (e) {
    el.innerHTML = '<p class="mkt-muted">' + FengI18n.t('market.none','暂无') + '</p>';
  }
}
loadComprehensive();
</script>
