<div class="page-header">
  <h2 data-i18n="page.watch">📡 持仓监控</h2>
  <div class="breadcrumb"><a href="/">系统总览</a> / 持仓监控</div>
</div>

<!-- Action Bar -->
<div class="card" style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
  <button class="btn btn-primary" onclick="runDailyCheck()">▶ 每日检查</button>
  <a href="/watch/history" class="btn btn-outline">📜 历史持仓</a>
  <span id="last-check" style="font-size:13px;color:var(--text-muted);">—</span>
  <span id="status-spinner" style="display:none;font-size:13px;color:var(--primary);">⏳ 运行中...</span>
</div>

<!-- Summary Dashboard -->
<div class="dashboard-grid" id="summary-grid">
  <div class="stat-card">
    <div class="stat-value" id="total-count" style="color:var(--text);">—</div>
    <div class="stat-label">总持仓</div>
  </div>
  <div class="stat-card">
    <div class="stat-value positive" id="green-count">—</div>
    <div class="stat-label">正常 🟢</div>
  </div>
  <div class="stat-card">
    <div class="stat-value" id="yellow-count" style="color:var(--yellow);">—</div>
    <div class="stat-label">关注 🟡</div>
  </div>
  <div class="stat-card">
    <div class="stat-value negative" id="red-count">—</div>
    <div class="stat-label">警告 🔴</div>
  </div>
</div>

<!-- Holdings Detail -->
<div class="section-title">持仓退出条件状态</div>
<div id="holdings-list">
  <div class="empty-state"><p>点击"每日检查"加载持仓数据</p></div>
</div>

<!-- Recent Log -->
<div class="section-title" style="margin-top:24px">最近决策记录</div>
<div id="log-list">
  <div class="empty-state"><p>暂无记录</p></div>
</div>

<script>
let currentData = null;

// Load status on page load
window.addEventListener('DOMContentLoaded', async () => {
  const res = await fetch('/api/watch/status');
  if (res.ok) {
    const data = await res.json();
    if (data && data.total_holdings !== undefined) {
      renderDashboard(data);
    }
  }
  loadLog();
});

async function runDailyCheck() {
  document.getElementById('status-spinner').style.display = 'inline';
  document.querySelector('#summary-grid .btn-primary')?.style.setProperty('opacity', '0.6');
  try {
    const res = await fetch('/api/watch/daily', { method: 'POST' });
    const data = await res.json();
    renderDashboard(data);
  } catch (e) {
    alert('检查失败: ' + e.message);
  } finally {
    document.getElementById('status-spinner').style.display = 'none';
    document.querySelector('#summary-grid .btn-primary')?.style.removeProperty('opacity');
  }
}

function renderDashboard(data) {
  currentData = data;
  document.getElementById('total-count').textContent = data.total_holdings || 0;
  document.getElementById('green-count').textContent = data.green || 0;
  document.getElementById('yellow-count').textContent = data.yellow || 0;
  document.getElementById('red-count').textContent = data.red || 0;

  const ts = data.generated_at ? new Date(data.generated_at).toLocaleString('zh-CN') : '';
  document.getElementById('last-check').textContent = '上次检查: ' + (data.date || ts);

  renderHoldings(data.results || []);
}

function renderHoldings(holdings) {
  const container = document.getElementById('holdings-list');
  if (holdings.length === 0) {
    container.innerHTML = '<div class="empty-state"><p>暂无持仓数据</p></div>';
    return;
  }

  let html = '';
  holdings.forEach(h => {
    const pos = h.position || {};
    const ret = pos.return_pct;
    const retClass = ret >= 0 ? 'positive' : 'negative';
    const retStr = ret != null ? (ret >= 0 ? '+' : '') + ret.toFixed(1) + '%' : '—';
    const icon = { GREEN: '🟢', YELLOW: '🟡', RED: '🔴' }[h.overall] || '⚪';
    const statusColor = { GREEN: 'var(--green)', YELLOW: 'var(--yellow)', RED: 'var(--red)' }[h.overall] || 'var(--text-muted)';

    html += '<div class="card">';
    html += '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">';
    const dispName = h.name && h.name !== h.ticker ? h.name : fengName(h.ticker);
    html += '<div><strong style="font-size:18px;">' + icon + ' ' + dispName + '</strong>';
    if (dispName !== h.ticker) html += ' <span style="font-size:13px;color:var(--text-muted)">' + h.ticker + '</span>';
    html += '</div>';
    html += '<span style="padding:4px 10px;border-radius:4px;font-weight:600;font-size:14px;background:' + statusColor + '22;color:' + statusColor + ';">' + h.overall + '</span>';
    html += '</div>';

    html += '<div style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;font-size:14px;">';
    html += '<div><span style="color:var(--text-muted)">成本</span> ¥' + (pos.avg_cost || '—').toLocaleString() + '</div>';
    html += '<div><span style="color:var(--text-muted)">现价</span> ¥' + (pos.current_price || '—').toLocaleString() + '</div>';
    html += '<div class="' + retClass + '"><span style="color:var(--text-muted)">盈亏</span> ' + retStr + '</div>';
    html += '<div><span style="color:var(--text-muted)">市值</span> ¥' + (pos.market_value || 0).toLocaleString() + '</div>';
    html += '</div>';

    if (h.thesis) {
      html += '<div style="margin-top:8px;font-size:13px;color:var(--text-muted);font-style:italic;">📄 ' + h.thesis.slice(0, 100) + (h.thesis.length > 100 ? '…' : '') + '</div>';
    }

    html += '<div style="margin-top:4px;font-size:12px;color:var(--text-muted);">资本阶段: ' + (h.capital_phase || 'capital_at_risk') + '</div>';

    html += '<div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;">';
    html += '<a href="/holdings/' + h.ticker + '" class="btn btn-sm btn-primary">持仓详情</a>';
    html += '<button class="btn btn-sm btn-outline" onclick="runReview(\'' + h.ticker + '\')">复盘</button>';
    html += '<a href="/watch/sell/' + h.ticker + '" class="btn btn-sm btn-danger-outline">卖出</a>';
    html += '</div>';

    html += '</div>';
  });

  container.innerHTML = html;
}

async function runReview(ticker) {
  if (!confirm('确定对 ' + ticker + ' 执行复盘？将生成复盘文件并记录日志。')) return;
  try {
    const res = await fetch('/api/watch/review/' + ticker, { method: 'POST' });
    const data = await res.json();
    alert(data.message || '复盘完成');
    loadLog();
  } catch (e) {
    alert('复盘失败: ' + e.message);
  }
}

async function loadLog() {
  try {
    const res = await fetch('/api/watch/log?limit=10');
    const data = await res.json();
    const container = document.getElementById('log-list');
    if (!data.entries || data.entries.length === 0) {
      container.innerHTML = '<div class="empty-state"><p>暂无记录</p></div>';
      return;
    }
    let html = '<div class="activity-list">';
    data.entries.forEach(e => {
      const ts = e.timestamp ? e.timestamp.slice(0, 19) : (e.date || '?');
      const dtype = e.type || '?';
      const icons = { daily_check: '📊', review: '📝', buy: '🟢', sell: '🔴', alert: '🔔' };
      const icon = icons[dtype] || '•';
      html += '<div class="activity-item">';
      html += '<span>' + icon + '</span>';
      html += '<span style="font-size:12px;color:var(--text-muted)">' + ts + '</span>';
      html += '<span class="activity-layer">' + dtype.toUpperCase() + '</span>';
      if (e.ticker) html += '<span class="activity-ticker">' + e.ticker + '</span>';
      html += '<span style="font-size:13px;">' + (e.summary || '') + '</span>';
      html += '</div>';
    });
    html += '</div>';
    html += '<div style="margin-top:8px;"><a href="/journal" class="btn btn-sm btn-outline">查看全部 →</a></div>';
    container.innerHTML = html;
  } catch (e) {
    // ignore
  }
}
</script>
