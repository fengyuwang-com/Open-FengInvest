<% var ticker = holding.ticker || holding.id; %>
<% var px = holding.position.current_price || holding.position.nav; %>
<% var pnl = px && holding.position.avg_cost ? (px / holding.position.avg_cost - 1) * 100 : null; %>

<div class="page-header">
  <div class="breadcrumb"><a href="/holdings">持仓</a> / <%= holding.name || ticker %></div>
  <h2><%= holding.name || ticker %> <span class="num" style="font-size:16px;color:var(--text-muted);font-weight:500;"><%= ticker %></span></h2>
  <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
    <a class="btn btn-danger" href="/watch/sell/<%= ticker %>">📤 卖出决策</a>
    <a class="btn btn-accent" href="/holdings/<%= ticker %>/review">🔁 复盘</a>
    <a class="btn" href="/research/<%= ticker %>">🔬 关联研究</a>
    <a class="btn" href="/rollover">🔄 滚存工具</a>
  </div>
</div>

<div class="dashboard-grid">
  <div class="stat-card"><div class="stat-label">成本 → 现价</div><div class="stat-value num" style="font-size:20px;"><%= holding.position.avg_cost != null ? Number(holding.position.avg_cost).toFixed(2) : '—' %> → <%= px != null ? Number(px).toFixed(2) : '—' %></div></div>
  <div class="stat-card"><div class="stat-label">持仓回报</div>
    <div class="stat-value <%= pnl != null ? (pnl >= 0 ? 'positive' : 'negative') : '' %>" style="font-size:22px;"><%= pnl != null ? (pnl >= 0 ? '+' : '') + pnl.toFixed(1) + '%' + (pnl >= 0 ? '▲' : '▼') : '—' %></div>
  </div>
  <div class="stat-card"><div class="stat-label">股数 / 钱包</div><div class="stat-value" style="font-size:20px;"><%= holding.position.shares || holding.position.units || '—' %></div>
    <div style="font-size:11px;color:var(--text-muted);margin-top:4px;"><%= holding.account_type === 'TRADING' ? '投机钱包 ⚠' : '投资钱包' %></div>
  </div>
  <div class="stat-card"><div class="stat-label">下次回顾</div><div class="stat-value" style="font-size:20px;color:var(--<%= holding.triggers && holding.triggers.next_review_date && new Date(holding.triggers.next_review_date) < new Date() ? 'danger' : 'text' %>);"><%= (holding.triggers && holding.triggers.next_review_date) || '—' %></div></div>
</div>

<div class="card">
  <h3 class="section-title">持仓档案</h3>
  <div class="detail-grid">
    <div class="field-row"><label>市场 / 板块</label><span><%= holding.market || '—' %> · <%= holding.segment || '—' %></span></div>
    <div class="field-row"><label>资金域</label><span><%= holding.capital_zone || '—' %></span></div>
    <div class="field-row"><label>买入日 / 券商</label><span><%= (holding.meta && holding.meta.buy_date) || '—' %> · <%= holding.broker || '—' %></span></div>
    <div class="field-row"><label>滚存阶段</label><span><%= holding.capital_rollover && holding.capital_rollover.phase === 'recovered' ? '本金已回收 ✓（可考虑滚存）' : '风险资本在市' %></span></div>
  </div>
</div>

<% var reviewDate = holding.triggers && holding.triggers.next_review_date;
   var reviewDays = reviewDate ? Math.round((new Date(reviewDate) - new Date()) / 86400000) : null;
   var isTrading = holding.account_type === 'TRADING'; %>
<% if (holding.thesis) { %>
<div class="card" style="border-left:3px solid var(--accent);">
  <h3 class="section-title">📜 买入论文<%= isTrading ? '（投机钱包·机械止损 -20%）' : '（投资钱包·论文止损）' %></h3>
  <% if (holding.thesis.summary) { %>
    <p style="font-size:17px;font-weight:600;line-height:1.5;margin:0 0 12px 0;"><%= holding.thesis.summary %></p>
  <% } %>
  <div class="md-content" style="font-size:14px;line-height:1.8;">
    <% if (holding.thesis.original) { %><p style="color:var(--text-secondary);"><%= holding.thesis.original %></p><% } %>
    <% if (holding.thesis.mirror_test) { %>
      <details><summary style="cursor:pointer;font-size:13px;color:var(--text-muted);">照镜子测试（买入时的自己）</summary><p style="font-size:13px;color:var(--text-muted);"><%= holding.thesis.mirror_test %></p></details>
    <% } %>
  </div>
  <% var reds = holding.thesis.redlines || holding.thesis.exit_conditions || []; %>
  <% if (reds.length) { %>
    <div style="margin-top:16px;">
      <h4 style="font-size:13px;color:var(--danger);margin:0 0 8px 0;">🚨 论文证伪条件（redlines）——碰到任何一条就是卖出信号，与价格无关</h4>
      <div class="alert-list">
        <% reds.forEach(function(r, i) { %>
          <div class="alert-item danger"><span class="num" style="color:var(--text-muted);"><%= i + 1 %></span><span><%= typeof r === 'string' ? r : (r.statement || r.text || JSON.stringify(r)) %></span></div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% if ((holding.thesis.hypotheses || []).length) { %>
    <div style="margin-top:16px;">
      <h4 style="font-size:13px;color:var(--text-muted);margin:0 0 8px 0;">🧪 假设验证进度</h4>
      <table class="holdings-table">
        <thead><tr><th>假设</th><th>验证方式</th><th>频率</th><th>状态</th></tr></thead>
        <tbody>
        <% holding.thesis.hypotheses.forEach(function(hp) {
             var st = hp.status || '?';
             var cls = st === 'valid' ? 'green' : st === 'invalid' || st === 'falsified' ? 'red' : 'yellow';
             var cn = st === 'valid' ? '成立' : st === 'invalid' || st === 'falsified' ? '证伪' : st;
        %>
          <tr><td><%= hp.statement || hp.id %></td><td><%= hp.verify || '—' %></td><td><%= hp.freq || '—' %></td><td><span class="badge badge-<%= cls %>"><%= cn %></span></td></tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<% } else { %>
<div class="alert-item warning">
  <span>⚠️ 这笔持仓<b>没有登记论文</b>——无 thesis.original + redlines 的持仓 = 黄灯（fengwatch check_thesis_missing）。亏损持有无论文支撑即散户处置效应（Odean 1998）。<a href="/holdings/<%= ticker %>/review">补建论文 →</a></span>
</div>
<% } %>
<% if (!isTrading && pnl != null && pnl < 0 && holding.thesis) { %>
<div class="alert-item warning">
  <span>🪞 当前浮亏 <%= pnl.toFixed(1) %>%。<b>投资账户不因价格卖出</b>——因论文卖（双账户规则 2026-08-16）。检查上面的证伪条件：基本面未变 = 继续持有；基本面同步恶化 = 走 <a href="/watch/sell/<%= ticker %>">卖出决策流程</a>。因亏损而卖 = 散户思维。</span>
</div>
<% } %>
<% if (reviewDays != null && reviewDays < 0) { %>
<div class="alert-item danger">
  <span>🔴 回顾日已过期 <%= -reviewDays %> 天（<%= reviewDate %>）——定期复盘是强迫执行的一部分。<a href="/holdings/<%= ticker %>/review">去复盘 →</a></span>
</div>
<% } %>

<div class="card">
  <h3 class="section-title">检查卡（fengwatch check 十规则）</h3>
  <button class="btn btn-accent" id="chkBtn" onclick="runCheck()">跑单只检查</button>
  <div id="check-out" style="margin-top:12px;"></div>
</div>

<script>
async function runCheck() {
  var btn = document.getElementById('chkBtn');
  btn.disabled = true; btn.textContent = '检查中…（fengwatch.py check）';
  var el = document.getElementById('check-out');
  try {
    var r = await fetch('/api/watch/check/<%= ticker %>');
    var d = await r.json();
    if (!r.ok) { el.innerHTML = '<div class="alert alert-danger">' + (d.error || '失败') + '</div>'; }
    else {
      var rules = d.rules || d.checks || [];
      el.innerHTML = Array.isArray(rules) && rules.length
        ? '<table class="data-table"><thead><tr><th>规则</th><th>状态</th><th>说明</th></tr></thead><tbody>' +
          rules.map(function(x) {
            return '<tr><td>' + (x.rule || x.name || '?') + '</td><td><span class="badge badge-' +
              (String(x.status || x.triggered).match(/(ok|false|pass)/i) ? 'green' : 'red') + '">' + (x.status || (x.triggered ? '触发' : '未触发')) + '</span></td><td style="font-size:12px;color:var(--text-muted);">' + (x.message || x.detail || x.note || '') + '</td></tr>';
          }).join('') + '</tbody></table>'
        : '<pre style="font-size:12px;white-space:pre-wrap;background:var(--bg-inset);padding:12px;border-radius:8px;max-height:360px;overflow:auto;">' + JSON.stringify(d, null, 2).slice(0, 3000) + '</pre>';
    }
  } catch (e) { el.textContent = '网络错误: ' + e.message; }
  btn.disabled = false; btn.textContent = '跑单只检查';
}
</script>
