# ============================================================
# FengInvest — .gitignore
# 防止个人/敏感数据泄露。修改前请确认是否影响开源fork
# ============================================================

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# ── Node ──
node_modules/
fengweb/node_modules/

# ── 构建产物 ──
fengweb/dist/

# ── 个人数据（不开源）──────────────────────────────────────
alerts/
holdings/
logs/
reviews/
research/060-companies/
research/speculative/
portfolio/
knowledge/personal/
research/070-reports/current-gitee-repos.md
fengmem.md
FENGMEM.md
todo.md

# ── 个人配置 ──
.claude/
.agents/
.zcode/
.workbuddy/
.vscode/
.idea/
*.code-workspace

# ── 凭据与密钥 ──
.env
.env.*
*.key
*.pem
*.pfx
*.p12
id_rsa*
settings.local.json
credentials.json
token*
secret*
# 例外：设计系统的 CSS 变量文件（这是设计 token，不是密钥凭据）
!design/prototype/tokens.css
!fengweb/public/css/tokens.css

# ── 数据库（过大，不入git） ──
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.sqlite
*.sqlite3
*.duckdb
data/changesets/
data/*.snap_*

# ── 数据缓存 / 个人数据 ──
data/cache/
data/sec/
data/watchlist.json
data/pit/
data/reports/
data/test_*

# ── 系统文件 ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── 日志与检查点 ──
*.log
data/.refine_checkpoint.json
data/.fundamentals_checkpoint.json
data/.ai-berkshire-sync.json
logs/backfill_*.log
logs/checkpoint_*.txt

# ── skill / 临时生成文件 ──
skills-lock.json
research/temp_*
research/state/
Temp/

# ── 已知废弃/旧目录 ──
tools/alpha-skills/
research/080-state/
# 开源项目评估时 clone 的源码仓库（不提交）
research/opensource-eval/RockyZSU-Stock/
research/opensource-eval/pwb-toolbox/
research/opensource-eval/qlib/
research/opensource-eval/quant-mind/
data/config/llm_config.json
